# Copy to .env and fill in what you need. Everything is optional.

# Vercel AI Gateway key for free shifts. Without it, every player brings their own key.
AI_GATEWAY_API_KEY=
# Optional: free shifts on the models Runware offers run on this key instead of the gateway.
RUNWARE_API_KEY=

# Models free shifts may use, comma separated; default: deepseek/deepseek-v4.1-flash.
FREE_MODELS=
# Free-shift limits without sign-in (only used with AI_GATEWAY_API_KEY). With AUTH_SECRET, an
# account's credit is the only limit, and the daily budget only counts.
FREE_SHIFT_TOKENS=250000
FREE_DAILY_TOKENS=5000000
FREE_SHIFTS_PER_DAY=3

# Sign-in. With AUTH_SECRET, shifts on our key need a signed-in player with credit: FREE_CREDIT_USD
# once on sign-up, then top-ups bought through Freemius. Each model call takes USAGE_MULTIPLIER times
# its price off the credit; a shift needs MIN_START_USD to start. Without AUTH_SECRET, anyone gets
# FREE_SHIFTS_PER_DAY per address.
# AUTH_SECRET signs the sign-in cookie: a long random string.
AUTH_SECRET=
FREE_CREDIT_USD=0.5
USAGE_MULTIPLIER=2
MIN_START_USD=0.05
# OAuth clients; redirect URIs are <PUBLIC_URL>/api/auth/google/callback and .../github/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Top-ups sold through Freemius (needs AUTH_SECRET): one one-off plan per amount, as
# <planId>:<dollars>,... e.g. 1001:10,1002:20,1003:50,1004:200. The checkout returns to
# <PUBLIC_URL>/api/billing/return; the webhook is <PUBLIC_URL>/api/billing/webhook.
FREEMIUS_PRODUCT_ID=
FREEMIUS_TOPUPS=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_API_KEY=
# Test cards only, unless false.
FREEMIUS_SANDBOX=true

# Shift starts per address per hour, on any key.
SHIFTS_PER_HOUR=30

# Models offered to players, comma separated, in gateway naming. Default: a built-in list.
MANAGER_MODELS=

# Your own model server with an OpenAI-compatible API (Ollama, llama.cpp, vLLM), offered as "Local".
# Players pick it without a key. Ollama: http://127.0.0.1:11434/v1
LOCAL_LLM_URL=
LOCAL_LLM_API_KEY=

# Optional Vertex AI Express Mode project/location override for global-only models (e.g. global).
VERTEX_PROJECT=
VERTEX_LOCATION=

# Server.
HOST=127.0.0.1
PORT=8755
# Time per instruction, in milliseconds.
INSTRUCTION_TIMEOUT_MS=90000
# Set to 1 behind Cloudflare, so limits count players by CF-Connecting-IP (X-Forwarded-For is ignored).
TRUST_PROXY=0
# Hosts allowed to set CF-Connecting-IP, comma-separated (e.g. the tunnel's container name).
# Empty: any peer is believed when TRUST_PROXY=1.
TRUSTED_PROXIES=
# Where shared reviews and the free-shift counts are saved. Default: server/data
DATA_DIR=
# 0 turns review sharing off.
SHARING=1

# Links shown to players.
PUBLIC_URL=
SOURCE_URL=
DONATE_URL=
